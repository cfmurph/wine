# Copy to deploy/production.env and replace each CHANGE_ME. That file is ignored by git.
ENVIRONMENT=production
POSTGRES_USER=wineapp
POSTGRES_PASSWORD=CHANGE_ME_production_database_password
POSTGRES_DB=wineapp
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_production_secret_at_least_32_characters
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=https://CHANGE_ME.example.com
NEXT_PUBLIC_API_URL=https://CHANGE_ME.example.com/api/v1

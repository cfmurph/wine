# Copy to deploy/staging.env and replace each CHANGE_ME. That file is ignored by git.
ENVIRONMENT=staging
POSTGRES_USER=wineapp
POSTGRES_PASSWORD=CHANGE_ME_staging_database_password
POSTGRES_DB=wineapp
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_staging_secret_at_least_32_characters
BACKEND_PORT=8100
FRONTEND_PORT=3100
CORS_ORIGINS=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:8100/api/v1
